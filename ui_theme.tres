default_font = ExtResource("font_kenney")
default_font_size = 16

Button/colors/font_color = Color(1, 0.97, 0.9, 1)
Button/colors/font_disabled_color = Color(0.56, 0.55, 0.63, 0.7)
Button/colors/font_focus_color = Color(1, 0.97, 0.9, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.9, 0.86, 0.78, 1)
Button/constants/outline_size = 0
Button/font_sizes/font_size = 16
Button/styles/disabled = SubResource("sb_btn_d")
Button/styles/focus = SubResource("sb_btn_h")
Button/styles/hover = SubResource("sb_btn_h")
Button/styles/normal = SubResource("sb_btn_n")
Button/styles/pressed = SubResource("sb_btn_p")

Label/colors/font_color = Color(1, 0.97, 0.9, 1)
Label/font_sizes/font_size = 16

ProgressBar/colors/font_color = Color(1, 1, 1, 1)
ProgressBar/styles/background = SubResource("sb_prog_bg")
ProgressBar/styles/fill = SubResource("sb_prog_fill")

PlateMoney/base_type = &"PanelContainer"
PlateMoney/styles/panel = SubResource("sb_plate_money")

PlateLives/base_type = &"PanelContainer"
